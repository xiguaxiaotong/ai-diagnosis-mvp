# ============================================================
# AI 诊断 MVP 环境变量模板（复制为 .env 后填写；不要提交真实密钥）
# 收编历史：W9 热身统一进 app/config.py 的 Settings 类，
# 字段名 = 环境变量名；不设的项走 config.py 里的默认值。
# ============================================================

# ========== 对话模型（P5，DeepSeek）==========
# 到 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-你的deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.7
CHAT_TIMEOUT=60

# ========== 计费单价（元 / 1M tokens，W8 Day2）==========
# 仅用于会话成本估算（非结算）；调价只改这里不动代码
# 默认对齐 deepseek-chat 2025 官方刊例价
DEEPSEEK_PRICE_PROMPT=2.0
DEEPSEEK_PRICE_COMPLETION=3.0

# ========== Embedding（本地运行，无需 key）==========
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

# ========== 服务 ==========
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ========== 邮件（W7 Day1）==========
# BASE_URL：邮件链接前缀（云上改公网域名 + HTTPS）
BASE_URL=http://localhost:3000
# 邮件后端：console / tencent / aliyun / smtp。MVP 仅实现 console
EMAIL_BACKEND=console

# ========== 运营后台 admin 白名单（W7 Day5）==========
# 逗号分隔 user.id；默认空 = 没人是 admin
# 查 user.id：SELECT id, username FROM users;
# 上线时填真实运营账号的 user.id（不要 commit 实际值，留空让运维填）
ADMIN_USER_IDS=

# ========== 本地数据路径（一般不用设）==========
# 默认挂 backend/data/；测试隔离 / 迁移时才覆盖
# SQLITE_PATH=
# CHECKPOINTS_PATH=
# CHROMA_DIR=
# CASES_DIR=
# TRACE_PATH=
